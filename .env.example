# Owner sign-in (Auth.js). Only this email may open the desk.
OWNER_EMAIL=you@example.com
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000
AUTH_PROVIDER=google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Local only. Never honoured on Vercel or NODE_ENV=production.
# AUTH_DEV_BYPASS=1

# Stores. Default is local SQLite. Memory is the demo / serverless fallback.
DECISION_SOURCE=sqlite
TASK_STORE=sqlite
DESK_LEDGER=sqlite
# DESK_SQLITE_PATH=./data/desk.sqlite
# DATABASE_URL=postgres://…

# Board column labels, comma-separated. Empty = one column per store status.
# BOARD_COLUMNS=Backlog,To do,In progress,Blocked,Done

# Optional static demo (no sign-in, no chat, no webhooks, no agent API).
# DESK_DEMO=1
# NEXT_PUBLIC_DESK_DEMO=1
# NEXT_PUBLIC_BASE_PATH=/DeskOS

# Optional owner alerts (independent of per-agent HMAC webhooks).
# SLACK_WEBHOOK_URL=
# NOTIFY_EMAIL_TO=
# NOTIFY_EMAIL_FROM=
# NOTIFY_EMAIL_WEBHOOK_URL=

# Optional chat (your own completions URL). Off unless set.
# CHAT_COMPLETIONS_URL=

# Timezone for ages and reply stamps.
# DESK_TIMEZONE=America/Los_Angeles

# Queue order. Default is stakes (overdue, cost of delay, door, then age).
# QUEUE_SORT=stakes
# QUEUE_SORT=age

# Days until a new Park asks keep / park again / decline. Default 14. Existing parked rows are not rewritten.
# PARK_REVISIT_DAYS=14

# Optional example Notion adapter (see adapters/notion/README.md).
# DECISION_SOURCE=notion
# TASK_STORE=notion
# NOTION_TOKEN=
# NOTION_DECISIONS_DATA_SOURCE_ID=
# NOTION_TASKS_DATA_SOURCE_ID=
# Optional extra Brief Item names (read/write only when the property exists).
# NOTION_OPTIONS_PROP=Options
# NOTION_RECOMMENDATION_PROP=Recommendation
# NOTION_DOOR_TYPE_PROP=Door type
# NOTION_COST_OF_DELAY_PROP=Cost of delay
# NOTION_DEADLINE_PROP=Deadline
# NOTION_DEFAULT_IF_NO_ANSWER_PROP=Default if no answer
# NOTION_DEFAULT_IF_NO_ANSWER_NOTE_PROP=Default if no answer note
# NOTION_NEEDS_SPLIT_PROP=Needs split
# NOTION_SPLIT_REASON_PROP=Split reason
# NOTION_PARENT_DECISION_PROP=Parent decision
# NOTION_SPLIT_SENT_BACK_PROP=Split sent back at
# NOTION_REVISIT_AT_PROP=Revisit at
# NOTION_REVISIT_STATE_PROP=Revisit state
# NOTION_BRIEF_OVERRIDES_PROP=Brief overrides
