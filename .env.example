# Owner sign-in (Auth.js). Only this email may open the desk.
OWNER_EMAIL=you@example.com
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000
AUTH_PROVIDER=google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Local only. Never honoured on Vercel or NODE_ENV=production.
# AUTH_DEV_BYPASS=1

# Stores. Default is local SQLite. Memory is the demo / serverless fallback.
DECISION_SOURCE=sqlite
TASK_STORE=sqlite
DESK_LEDGER=sqlite
# DESK_SQLITE_PATH=./data/desk.sqlite
# DATABASE_URL=postgres://…

# Board column labels, comma-separated. Empty = one column per store status.
# BOARD_COLUMNS=Backlog,To do,In progress,Blocked,Done

# Optional static demo (no sign-in, no chat, no webhooks, no agent API).
# DESK_DEMO=1
# NEXT_PUBLIC_DESK_DEMO=1
# NEXT_PUBLIC_BASE_PATH=/DeskOS

# Optional owner alerts (independent of per-agent HMAC webhooks).
# SLACK_WEBHOOK_URL=
# NOTIFY_EMAIL_TO=
# NOTIFY_EMAIL_FROM=
# NOTIFY_EMAIL_WEBHOOK_URL=

# Optional chat (your own completions URL). Off unless set.
# CHAT_COMPLETIONS_URL=

# Timezone for ages and reply stamps.
# DESK_TIMEZONE=America/Los_Angeles

# Queue order: stakes (cost of delay, then deadline, then age) or age.
# Demo defaults to stakes; live desks default to age unless this is set.
# QUEUE_SORT=stakes
# NEXT_PUBLIC_QUEUE_SORT=stakes

# Require the full decision brief on new raises (options, recommendation, door, cost_of_delay, deadline).
# DESK_BRIEF_REQUIRED=1

# Days until a new Park asks keep / park again / decline. Existing parked rows are not rewritten.
# PARK_REVISIT_DAYS=30

# Optional example Notion adapter (see adapters/notion/README.md).
# DECISION_SOURCE=notion
# TASK_STORE=notion
# NOTION_TOKEN=
# NOTION_DECISIONS_DATA_SOURCE_ID=
# NOTION_TASKS_DATA_SOURCE_ID=
